# === Telegram ===
# Продающий бот (@CleanTrade_bot)
SALES_BOT_TOKEN=
# Бот-гейт доступа + рассылка сигналов (@HexusCrypto_bot)
ACCESS_BOT_TOKEN=
ACCESS_BOT_USERNAME=HexusCrypto_bot
# Бот поддержки (@CleanTradeSupport_bot) - ЕДИНСТВЕННЫЙ слушатель апдейтов.
# Обязателен для привязки Telegram на странице подписки.
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=CleanTradeSupport_bot
# Общий секрет платёжки и бота: бот подтверждает им код подписки.
# Без него /v1/tg/confirm и /v1/tg/mykey отвечают 503 - привязка Telegram
# на сайте просто не работает.
SUPPORT_SHARED_SECRET=
# Срок жизни кода подтверждения Telegram, сек (15 минут)
TG_AUTH_TTL=900
# ID админов через запятую
ADMIN_IDS=883560328

# === Платёжка USDT (TRC20) ===
# Ключ с https://tronscan.org (API)
TRONSCAN_API_KEY=
# Кошелёк для приёма платежей
TRX_WALLET=
# Уникальные суммы заказов: BASE_AMOUNT + 0.50..0.99 (цена = BASE_AMOUNT+1)
BASE_AMOUNT=9
# Период проверки TronScan, сек
CHECK_INTERVAL=30
# Окно активного ожидания платежа, сек
WAITING_TIME=1800
# Время жизни заказа, сек (24 часа)
ORDER_EXPIRATION_SECONDS=86400
# 1 = имитация оплат (тест), 0 = реальный TronScan
USE_MOCK=0
# Срок заявки на тариф, сек (1 час): заказ ДЕРЖИТ свою сумму - детект платежа
# идёт по сумме, поэтому брошенная заявка блокирует тариф для остальных
PLAN_ORDER_TTL=3600
# Сколько секунд ловим оплату, пришедшую после срока (12 часов)
PLAN_PAYMENT_GRACE=43200
# Секрет HMAC-подписи вебхука (X-CleanTrade-Signature). Получатель по нему
# проверяет, что "оплачено" прислали мы, а не подделка. Пусто - вебхук уходит
# БЕЗ подписи, и отличить наше уведомление от чужого нельзя.
WEBHOOK_SECRET=
# Лимит бесплатных активаций в сутки на IP (0 = без лимита)
FREE_IP_DAILY_LIMIT=5
# Больше N разных Telegram с одного IP за сутки - метка в ленте админки
FREE_TG_IP_FLAG=3
# Версия API: её отдают /healthz и бейдж админки (единый источник)
API_VERSION=0.3.5
# Где лежит состояние. По умолчанию <корень проекта>/data - раскомментируй
# только если переносишь данные (пустое значение НЕ ставить: путь станет ".").
# DATA_DIR=/root/CleanProd/data
# LOG_DIR=/root/CleanProd/data/logs
# API-ключ мерчанта для Stablecoin Payment API
PAYMENT_API_KEY=сгенерируй_сам

# Ключ доступа к админ-панели /admin
ADMIN_KEY=
